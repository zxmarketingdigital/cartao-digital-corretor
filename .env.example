# Copie para .env e preencha. O .env NUNCA vai para o git.
# Em produção, cada valor entra com: wrangler secret put <NOME>

# Domínio onde o produto é servido (sem barra no fim)
PUBLIC_BASE_URL=https://seu-dominio.pt

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Só para instalar (aplicar migrations via Management API) — não vai para o Worker
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Resend (e-mail)
RESEND_API_KEY=
EMAIL_FROM="Cartão Digital <avisos@seu-dominio.pt>"

# Evolution API (WhatsApp — número DEDICADO a avisos)
EVOLUTION_API_URL=https://evolution.seu-dominio.pt
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=avisos-cartao

# Slug do cartão da própria empresa, servido em /cartao-visita
ZX_CARD_SLUG=zxlab

# PayPal (EUR)
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PRODUCT_PRICE_EUR=97.00

# Cloudflare Web Analytics (vazio = beacon omitido)
CF_BEACON_TOKEN=

# Meta Pixel da LP (opcional, vazio = omitido)
META_PIXEL_ID=
